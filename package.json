{
  "name": "tandem",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "author": "Max Medawar",
  "type": "module",
  "description": "A self-hosted MCP bridge for orchestrating Claude, Codex, shell, and Hermes sessions across your own Tailscale-connected devices.",
  "keywords": [
    "mcp",
    "claude",
    "multi-agent",
    "orchestration",
    "codex",
    "claude-code",
    "hermes",
    "tmux",
    "tailscale",
    "multi-device",
    "bridge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maxmedawar/tandem.git"
  },
  "homepage": "https://github.com/Maxmedawar/tandem#readme",
  "bugs": {
    "url": "https://github.com/Maxmedawar/tandem/issues"
  },
  "files": [
    ".env.example",
    "bridge",
    "src",
    "hub/src/protocol.ts",
    "hub/src/bridge-id.ts",
    "harnesses",
    "skills",
    "assets/tandem-logo.png",
    "tandem-orchestration.zip",
    "setup.sh",
    "SECURITY.md",
    "SETUP.md",
    "SETUP-PROMPT.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "start:stdio": "node --experimental-strip-types src/stdio-server.ts",
    "start:device": "node --experimental-strip-types src/device-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "re2js": "^2.10.0",
    "smol-toml": "^1.9.1",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
